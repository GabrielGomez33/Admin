# Admin Portal Server Configuration
ADMIN_PORT=8446
NODE_ENV=production

# Admin Authentication
# Generate password hash: node -e "require('bcryptjs').hash('your-password',12).then(h=>console.log(h))"
ADMIN_USER=admin
ADMIN_PASS_HASH=

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_JWT_SECRET=

# Service Health Endpoints
MIRROR_HEALTH_URL=https://127.0.0.1:8444/mirror/api/health
DINA_HEALTH_URL=https://127.0.0.1:8445/dina/api/v1/health

# PM2 Log Directory
PM2_LOGS_DIR=/root/.pm2/logs
