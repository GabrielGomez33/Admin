# Admin Portal Server Configuration
ADMIN_PORT=8446
NODE_ENV=production

# Admin Authentication
# Generate password hash: node -e "require('bcryptjs').hash('your-password',12).then(h=>console.log(h))"
ADMIN_USER=admin
ADMIN_PASS_HASH=

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_JWT_SECRET=

# Service Health Endpoints
MIRROR_HEALTH_URL=https://127.0.0.1:8444/mirror/api/health
DINA_HEALTH_URL=https://127.0.0.1:8445/dina/api/v1/health
# GPU tile — dina status endpoint (now gpu-enriched). Localhost is auto-trusted
# by dina; set DINA_SERVICE_KEY only if your dina requires a token for /status.
DINA_STATUS_URL=https://127.0.0.1:8445/dina/api/v1/status

# PM2 Log Directory
PM2_LOGS_DIR=/root/.pm2/logs

# ── Email Broadcasts ────────────────────────────────────────────────────────
# Base URL of mirror-server's internal admin email API (localhost only).
MIRROR_ADMIN_API_BASE=https://127.0.0.1:8444/mirror/api/admin/email
# Shared secret between admin-server and mirror-server. MUST match the value of
# MIRROR_INTERNAL_SECRET in mirror-server's .env exactly.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MIRROR_INTERNAL_SECRET=
# Optional: timeout for calls to the mirror email API (ms).
MIRROR_API_TIMEOUT_MS=20000
# Recipient count above which a send/schedule requires explicit confirmation.
ADMIN_EMAIL_CONFIRM_THRESHOLD=500
# Max accepted JSON body (raise if you allow larger attachments).
ADMIN_JSON_LIMIT=12mb

# ── Intake Simulation ───────────────────────────────────────────────────────
# Base URL of mirror-server's internal admin intake-simulation API (localhost
# only). Reuses the same MIRROR_INTERNAL_SECRET shared secret as the email API.
MIRROR_SIM_API_BASE=https://127.0.0.1:8444/mirror/api/admin/simulation
# Timeout for a full simulation round trip (ms). A run does register → upload ×2
# → store → verify → teardown, so allow generous headroom.
MIRROR_SIM_TIMEOUT_MS=120000
