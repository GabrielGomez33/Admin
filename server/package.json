{
  "name": "admin-server",
  "version": "1.0.0",
  "description": "TUGRR Admin Portal - System monitoring and diagnostics API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "npm run rebuild && sudo pm2 reload ecosystem.config.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.27",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
